{
  "name": "xnote-workspace",
  "private": true,
  "scripts": {
    "start": "pnpm --filter @textbus/xnote-playground dev",
    "dev:playground": "pnpm --filter @textbus/xnote-playground dev",
    "serve": "pnpm --filter @textbus/xnote serve",
    "build": "pnpm run build:lib && pnpm run build:playground",
    "build:playground": "pnpm --filter @textbus/xnote-playground build",
    "build:lib": "pnpm --filter @textbus/xnote build:lib",
    "publish:lib": "pnpm --filter @textbus/xnote publish:lib"
  },
  "packageManager": "pnpm@10.18.3"
}
