{
  "name": "@textbus/xnote",
  "version": "1.4.12",
  "description": "A high-performance rich text editor that supports multiplayer online collaboration.",
  "license": "MIT",
  "main": "./dist/index.js",
  "module": "./dist/index.esm.js",
  "types": "./dist/index.d.ts",
  "style": "./dist/index.css",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.esm.js",
      "require": "./dist/index.js",
      "default": "./dist/index.esm.js"
    },
    "./style.css": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.zh-CN.md"
  ],
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": [
    "*.css",
    "**/*.css"
  ],
  "keywords": [
    "textbus",
    "xnote",
    "富文本编辑器",
    "wysiwyg",
    "wysiwyg editor",
    "rich text editor",
    "editor",
    "html editor",
    "web editor",
    "collaborate"
  ],
  "scripts": {
    "serve": "npx y-websocket HOST=localhost PORT=1234 ",
    "build:lib": "rimraf dist && vite build --config vite.lib.config.ts",
    "prepublishOnly": "pnpm run build:lib",
    "publish:lib": "pnpm run build:lib && npm publish"
  },
  "dependencies": {
    "@tanbo/color": "^0.1.1",
    "@viewfly/ui-components": "^0.0.24",
    "@viewfly/ui-icons": "^0.0.24",
    "highlight.js": "^11.9.0",
    "katex": "^0.16.10",
    "markdown-it": "^14.1.1",
    "mermaid": "^11.14.0",
    "uuid": "^10.0.0"
  },
  "peerDependencies": {
    "@textbus/adapter-viewfly": "^5.4.3",
    "@textbus/collaborate": "^5.4.3",
    "@textbus/core": "^5.4.3",
    "@textbus/platform-browser": "^5.4.3",
    "@viewfly/core": "^3.0.5",
    "@viewfly/platform-browser": "^3.0.5"
  },
  "devDependencies": {
    "@swc/core": "^1.15.30",
    "@swc/helpers": "^0.5.21",
    "@textbus/adapter-viewfly": "^5.4.6",
    "@textbus/collaborate": "^5.4.6",
    "@textbus/core": "^5.4.6",
    "@textbus/platform-browser": "^5.4.6",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^22.15.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^5.8.0",
    "@typescript-eslint/parser": "^5.8.0",
    "@viewfly/core": "^3.0.5",
    "@viewfly/devtools": "^3.0.5",
    "@viewfly/platform-browser": "^3.0.5",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.5.0",
    "eslint-plugin-import": "^2.29.1",
    "postcss": "^8.4.38",
    "postcss-preset-env": "^8.5.0",
    "rimraf": "^5.0.1",
    "sass": "^1.63.4",
    "typescript": "^5.1.6",
    "unocss": "^66.6.8",
    "vite": "^8.0.9",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-swc-transform": "^1.1.1"
  },
  "author": {
    "name": "Tanbo",
    "email": "tanbohb@qq.com"
  },
  "bugs": {
    "url": "https://github.com/textbus/xnote/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/textbus/xnote.git"
  },
  "packageManager": "pnpm@10.18.3"
}
